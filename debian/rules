#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
# Without this, ctest exits 0 when no test is registered at all.
export CTEST_NO_TESTS_ACTION = error
# A fixture of these formats that does not extract fails the build.
export RAYE_ARCHIVE_EXPECT_READY = zip,7z,rar,rar5,tar,gz,bz2,xz,lzma,zst,lz4,lz,br,Z,cpio,ar,rpm,iso,cab

%:
	dh $@ --buildsystem=cmake

override_dh_auto_configure:
	dh_auto_configure -- -DBUILD_TESTING=ON

override_dh_auto_test:
	dh_auto_test -- ARGS+="-L raye --output-on-failure"

override_dh_missing:
	dh_missing --fail-missing
